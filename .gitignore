# Compiled class files
*.class
target/
out/
build/

# IDE files
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
*.swp
*.swo

# Test reports & generated output (local runs only)
test-output/
allure-results/
allure-report/
screenshots/
logs/
*.log

# CI publishes each run into reports/ci/run-<number>/ (never overwrites older runs)
!reports/
!reports/ci/
!reports/ci/**

# OS files
.DS_Store
Thumbs.db
*.tmp

# Maven
dependency-reduced-pom.xml

# Sensitive data - NEVER commit these
*.env
credentials.txt

# Local temp downloads / ad-hoc CI extracts (not part of framework)
ci-artifacts/
ci-reports-*/
ci-run*/
latest-ci-reports/
ci-*.zip
docs/preview/

# Excel lock files
~$*

# Browser drivers (large binaries; keep local — download if missing)
drivers/*.zip
drivers/Driver_Notes/
